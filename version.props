<Project>

  <!--
    Версия rasm = MajorVersion.MinorVersion.PatchVersion.

    MAJOR и MINOR задаются ВРУЧНУЮ здесь:
      MAJOR — при несовместимых изменениях ассемблируемого синтаксиса или формата .bin/.lst;
      MINOR — при обычном развитии (новая фича, доработка).

    PATCH считается автоматически: это число коммитов в ветке минус PatchBase
    (см. build.ps1 / build.sh и .github/workflows/release.yml).

    PatchBase — число коммитов в HEAD на момент выпуска Major.Minor.0. Меняй его
    вместе с MINOR, чтобы PATCH снова начался с нуля: git rev-list count HEAD.
    PatchBase = 0 означает «PATCH равен общему числу коммитов».
  -->
  <PropertyGroup>
    <MajorVersion>0</MajorVersion>
    <MinorVersion>9</MinorVersion>
    <PatchBase>40</PatchBase>
  </PropertyGroup>

</Project>
